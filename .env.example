# =====================================================
# MiniCRM AI - Environment Variables
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local to git.
# =====================================================

# ---- InsForge (public, available in browser) ----
# Get these by running:
#   npx -y @insforge/cli link
#   npx -y @insforge/cli secrets get ANON_KEY
# The URL also lives in .insforge/project.json under "oss_host".
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=eyJhbGciOi...

# Used by InsForge SDK SSR helpers to compute OAuth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- OpenAI (server-only, NEVER use NEXT_PUBLIC_*) ----
# The OPENAI_API_KEY must only live in server-side code (Server Actions,
# Route Handlers). It must NEVER be exposed to the browser.
OPENAI_API_KEY=sk-...
